# ---- Java / Maven build output ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml

# ---- Secrets & local config (NEVER commit an API key) ----
.env
.env.*
application-local.properties
*-local.properties
secrets/

# ---- Generated runtime data ----
history/
reports/
out/

# ---- LaTeX build artifacts ----
*.aux
*.out
*.log
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
# NOTE: generated PDFs live in reports/ (ignored above). *.pdf is deliberately NOT
# ignored globally so the subject PDF and the final technical report can be committed.

# ---- Frontend (role 6) ----
front/node_modules/
front/dist/
front/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDEs / editors ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
*.swp
nbproject/private/

# ---- OS noise ----
.DS_Store
Thumbs.db
